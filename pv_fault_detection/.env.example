# Copy this file to .env and fill in your values. Never commit .env.

# NREL PVDAQ API key (REQUIRES USER INPUT — register at https://developer.nrel.gov/signup/)
NREL_API_KEY=YOUR_NREL_API_KEY_HERE

# Optional: Weights & Biases (if switching tracker from mlflow to wandb via logging.tracker=wandb)
WANDB_API_KEY=YOUR_WANDB_API_KEY_HERE
